{
  "name": "pomekhi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A server-authoritative horror party game for a shared display and private phones.",
  "engines": {
    "node": "26.13.0",
    "npm": "11.20.0"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "env:check": "node scripts/check-environment.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsc -p tsconfig.server.json && vite build",
    "start": "node scripts/start-server.mjs",
    "start:public": "node --env-file-if-exists=.env scripts/start-public.mjs",
    "tuna:login": "node --env-file-if-exists=.env scripts/tuna.mjs login",
    "tunnel": "node --env-file-if-exists=.env scripts/tuna.mjs http",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest",
    "test:ci": "vitest run --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "docs:check": "node scripts/check-docs.mjs",
    "agent:test": "node scripts/test-agentkit.mjs",
    "agent:doctor": "node scripts/agent.mjs doctor",
    "agent:quick": "node scripts/agent.mjs check --quick",
    "agent:check": "node scripts/agent.mjs check",
    "agent:report": "node scripts/agent.mjs report",
    "agent:graph:status": "node scripts/agent.mjs graph status",
    "agent:graph:sync": "node scripts/agent.mjs graph sync",
    "agent:graph:query": "node scripts/agent.mjs graph query",
    "agent:graph:explain": "node scripts/agent.mjs graph explain",
    "agent:graph:path": "node scripts/agent.mjs graph path",
    "agent:graph:eval": "node scripts/agent.mjs graph eval"
  },
  "dependencies": {
    "express": "5.3.0",
    "qrcode": "1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.14.0",
    "happy-dom": "21.0.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}

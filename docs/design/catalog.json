{
  "schemaVersion": 1,
  "documents": [
    {
      "id": "runtime-foundation",
      "path": "docs/design/runtime-foundation.md",
      "sources": [
        "src/server",
        "src/shared",
        "src/client",
        "eslint.config.mjs",
        "scripts/dev.mjs",
        "scripts/start-server.mjs",
        "scripts/start-public.mjs",
        "scripts/tuna.mjs"
      ],
      "prefixes": [
        "src/server/",
        "src/shared/",
        "src/client/",
        "scripts/"
      ],
      "reviewWhen": [
        "startup or shutdown ownership",
        "transport or shared wire contract",
        "build layout",
        "state or recovery semantics",
        "client composition, public interface or import restrictions",
        "HTTP error policy or server startup cancellation"
      ]
    },
    {
      "id": "lobby-sessions",
      "path": "docs/design/lobby-sessions.md",
      "sources": [
        "src/server/lobby.ts",
        "src/server/transport/socket.ts",
        "src/shared/protocol.ts",
        "src/client/pages",
        "src/client/shared"
      ],
      "prefixes": [
        "src/client/pages/",
        "src/client/shared/"
      ],
      "reviewWhen": [
        "membership or authorization changes",
        "command validation, presence or replay behavior",
        "browser credential storage and reconnect",
        "invitation construction and client composition"
      ]
    },
    {
      "id": "dealing",
      "path": "docs/design/dealing.md",
      "sources": [
        "src/server/dealing.ts",
        "src/server/cards.ts",
        "src/server/lobby.ts",
        "src/shared/protocol.ts",
        "vite.config.ts"
      ],
      "prefixes": [
        "src/client/pages/host/",
        "src/client/pages/player/",
        "src/client/shared/api/"
      ],
      "reviewWhen": [
        "role assignment, bank, readiness or replacement behavior",
        "late membership during reading",
        "private projections and stale/repeated commands",
        "server file exposure or browser recovery"
      ]
    },
    {
      "id": "rounds",
      "path": "docs/design/rounds.md",
      "sources": [
        "src/server/game.ts",
        "src/server/lobby.ts",
        "src/server/dealing.ts",
        "src/server/transport/socket.ts",
        "src/server/app.ts",
        "src/shared/protocol.ts"
      ],
      "prefixes": [
        "src/client/shared/",
        "src/client/pages/host/",
        "src/client/pages/player/"
      ],
      "reviewWhen": [
        "phase transitions, settings, timers or pause",
        "round membership, role history or completion",
        "clock synchronization, sound ownership or recovered state",
        "timer and subscription disposal"
      ]
    },
    {
      "id": "search-actions",
      "path": "docs/design/search-actions.md",
      "sources": [
        "src/server/search.ts",
        "src/server/game.ts",
        "src/server/lobby.ts",
        "src/shared/protocol.ts",
        "src/server/cards.ts"
      ],
      "prefixes": [
        "src/client/pages/",
        "src/client/shared/"
      ],
      "reviewWhen": [
        "infection groups and release",
        "causal undo, scoring, frozen roster and provisional results",
        "personal projection and reconnect"
      ]
    }
  ]
}

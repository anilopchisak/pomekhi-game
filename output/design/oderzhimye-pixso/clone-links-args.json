{"file_key": "PvAwgT1U6s5Oj8tX7ShmIA", "script": "const ids=[\"5:13998\", \"5:14028\", \"5:14057\", \"5:14097\", \"5:14131\", \"5:14162\", \"5:14191\", \"5:14220\", \"5:14260\", \"5:14294\", \"5:14325\", \"5:14354\", \"5:14383\", \"5:14423\", \"5:14457\", \"7:14144\", \"7:14370\", \"7:14586\", \"7:14802\", \"7:15026\", \"7:15197\", \"7:15413\", \"7:15637\", \"7:15861\", \"7:16085\", \"7:16661\", \"7:16833\", \"7:17049\", \"7:17265\", \"7:17481\", \"7:17697\", \"7:16310\", \"7:16325\", \"7:16337\", \"7:16349\", \"7:16361\", \"7:16376\", \"7:16386\", \"7:16398\", \"7:16410\", \"7:16428\", \"7:16443\", \"7:16458\", \"7:16468\", \"7:16486\", \"7:16506\", \"7:16527\", \"7:16545\", \"7:16560\", \"7:16570\", \"7:16588\", \"7:16600\", \"7:16615\", \"7:16624\", \"7:16633\", \"7:16648\"];const byId={};for(const id of ids){const n=pixso.getNodeById(id);const targets=[n,...n.findAll(c=>c.name.startsWith('Action /'))];byId[id]={name:n.name,actions:targets.map(c=>({id:c.id,name:c.name,visible:c.visible,r:(()=>{try{return c.reactions?.map(r=>({trigger:r.trigger.type,timeout:r.trigger.timeout,dest:r.action?.destinationId,target:r.action?.destinationId&&pixso.getNodeById(r.action.destinationId)?.name})).slice(0,4)}catch(e){return []}})()}))};}return{byId};"}
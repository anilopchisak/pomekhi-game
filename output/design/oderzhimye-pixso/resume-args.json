{"file_key": "PvAwgT1U6s5Oj8tX7ShmIA", "script": "const button=pixso.getNodeById(\"3:3363\");const before=button.reactions;const dest='3:14223';button.reactions=[{trigger:{type:'ON_CLICK'},action:{type:'NODE',destinationId:dest,navigation:'NAVIGATE',transition:{type:'DISSOLVE',duration:0.25,easing:{type:'EASE_IN_AND_OUT'}}}}];const after=button.reactions;if(!after.length||after.some(r=>r.action?.destinationId!==dest))throw Error('Resume target mismatch');return{verified:true,node:button.id,before:before[0],after:after[0]};"}
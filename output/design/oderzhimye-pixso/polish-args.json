{"file_key": "PvAwgT1U6s5Oj8tX7ShmIA", "script": "const fonts=['Regular','Medium','Bold'].map(style=>({family:'Inter',style}));await Promise.all(fonts.map(f=>pixso.loadFontAsync(f)));const metrics={Display:[48,56],Title:[32,40],Heading:[22,28],Body:[16,24],Small:[13,18],Label:[14,20],Round:[13,18]};const changed=[];for(const id of [\"3:303\", \"3:13376\", \"3:13434\", \"3:332\", \"3:13405\", \"3:13463\", \"3:6633\", \"3:22831\", \"3:22856\", \"3:6660\", \"3:22881\", \"3:22902\", \"3:6681\", \"3:22923\", \"3:22952\", \"3:7019\", \"3:23603\", \"3:23624\", \"3:7636\", \"3:13936\", \"3:13945\", \"3:7911\", \"3:13954\", \"3:13963\", \"3:763\", \"5:14016\", \"5:14017\", \"5:14046\", \"5:14047\", \"5:14079\", \"5:14080\", \"5:14119\", \"5:14120\", \"5:14153\", \"5:14154\", \"5:14134\", \"5:14180\", \"5:14181\", \"5:14209\", \"5:14210\", \"5:14242\", \"5:14243\", \"5:14282\", \"5:14283\", \"5:14316\", \"5:14317\", \"5:14297\", \"5:14343\", \"5:14344\", \"5:14372\", \"5:14373\", \"5:14405\", \"5:14406\", \"5:14445\", \"5:14446\", \"5:14479\", \"5:14480\", \"5:14460\", \"7:14369\", \"7:14265\", \"7:14585\", \"7:14487\", \"7:14801\", \"7:14703\", \"7:15025\", \"7:14919\", \"7:14922\", \"7:15196\", \"7:15412\", \"7:15314\", \"7:15636\", \"7:15530\", \"7:15529\", \"7:15860\", \"7:15754\", \"7:15753\", \"7:16084\", \"7:15978\", \"7:15977\", \"7:16308\", \"7:16202\", \"7:16201\"]){const text=pixso.getNodeById(id);const style=text.name.split(' ')[0];if(!metrics[style])continue;const [size,leading]=metrics[style];text.fontSize=size;text.lineHeight={unit:'PIXELS',value:leading};if(text.fontSize!==size)throw Error('Size mismatch '+id);changed.push({id,size,leading});}\nfunction paint(hex){const v=parseInt(hex,16);return {type:'SOLID',color:{r:(v>>16)/255,g:((v>>8)&255)/255,b:(v&255)/255}}}\nfor(const id of [\"7:16443\", \"7:16361\"]){const frame=pixso.getNodeById(id);const actions=frame.children.find(n=>n.name==='\u0414\u0435\u0439\u0441\u0442\u0432\u0438\u044f');for(const [i,button]of actions.children.entries()){button.fills=[paint(i===1?'B9A1E8':'211B2D')];button.findOne(n=>n.type==='TEXT').fills=[paint(i===1?'17131F':'F1EDF7')];}}\nreturn{verified:true,changed,reviewIds:[\"7:16443\", \"7:16361\"]};"}
{"file_key": "PvAwgT1U6s5Oj8tX7ShmIA", "script": "const candidates=[{family:'Golos Text',style:'Regular'},{family:'Inter',style:'Regular'},{family:'Inter',style:'Medium'},{family:'Inter',style:'Bold'},{family:'Arial',style:'Regular'},{family:'IBM Plex Mono',style:'Medium',hash:'ac0c3464000d8fb6175b85f8fa3e30a3fb8351fe'}];const results=await Promise.allSettled(candidates.map(f=>pixso.loadFontAsync(f)));return{fonts:results.map((r,i)=>({f:candidates[i],status:r.status,value:r.value,reason:r.reason&&String(r.reason)}))};"}
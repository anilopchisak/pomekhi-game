# Local server. Tuna forwards requests to this server.
HOST=127.0.0.1
PORT=3000
# Optional: absolute path to a custom Tuna executable (paths with spaces are supported).
# TUNA_BIN=/path/to/tuna
# Optional: the exact free subdomain assigned to your account (shown by Tuna).
# TUNA_SUBDOMAIN=your-assigned-free-name
# Run npm run tuna:login; Tuna owns credentials in the operating-system keyring.
